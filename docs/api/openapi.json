{
  "openapi": "3.1.0",
  "info": {
    "title": "찾음표 API",
    "version": "0.1.0",
    "description": "기준 문서: 03_API명세서.md. 스키마 원본은 packages/shared."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/buildings": {
      "get": {
        "tags": [
          "건물"
        ],
        "summary": "건물 목록 (F-01)",
        "responses": {
          "200": {
            "description": "건물 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "buildings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name"
                        ]
                      }
                    }
                  },
                  "required": [
                    "buildings"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/buildings/nearest": {
      "get": {
        "tags": [
          "건물"
        ],
        "summary": "가장 가까운 건물 (F-01)",
        "description": "기준 거리(초안 300m)보다 멀면 building이 null이다.",
        "parameters": [
          {
            "schema": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -90,
              "maximum": 90
            },
            "required": false,
            "name": "lat",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            },
            "required": false,
            "name": "lng",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "가장 가까운 건물",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "building": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name"
                      ]
                    },
                    "distanceM": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "building",
                    "distanceM"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "좌표 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "VALIDATION_ERROR",
                            "INVALID_EMAIL_DOMAIN",
                            "INVALID_CODE",
                            "UNAUTHORIZED",
                            "FORBIDDEN",
                            "NOT_FOUND",
                            "EMAIL_TAKEN",
                            "MATCH_LOCKED",
                            "ALREADY_CLAIMED",
                            "ALREADY_ANSWERED",
                            "INVALID_STORAGE_TYPE",
                            "QR_EXPIRED",
                            "IMAGE_TOO_LARGE",
                            "NO_OBJECT_DETECTED",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR",
                            "AI_UNAVAILABLE"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "message": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "message"
                            ]
                          }
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/storage-places": {
      "get": {
        "tags": [
          "건물"
        ],
        "summary": "보관처 목록 (F-01)",
        "description": "buildingId를 주면 그 건물의 보관처가 앞에 온다(sameBuilding: true).",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "required": false,
            "name": "buildingId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "보관처 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "storagePlaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "building": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "name"
                            ]
                          },
                          "org": {
                            "type": "string",
                            "enum": [
                              "CENTER",
                              "GUARD"
                            ]
                          },
                          "guideText": {
                            "type": "string"
                          },
                          "sameBuilding": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "building",
                          "org",
                          "guideText",
                          "sameBuilding"
                        ]
                      }
                    }
                  },
                  "required": [
                    "storagePlaces"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "입력 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "VALIDATION_ERROR",
                            "INVALID_EMAIL_DOMAIN",
                            "INVALID_CODE",
                            "UNAUTHORIZED",
                            "FORBIDDEN",
                            "NOT_FOUND",
                            "EMAIL_TAKEN",
                            "MATCH_LOCKED",
                            "ALREADY_CLAIMED",
                            "ALREADY_ANSWERED",
                            "INVALID_STORAGE_TYPE",
                            "QR_EXPIRED",
                            "IMAGE_TOO_LARGE",
                            "NO_OBJECT_DETECTED",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR",
                            "AI_UNAVAILABLE"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "message": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "message"
                            ]
                          }
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
