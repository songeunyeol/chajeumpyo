                            "EMAIL_TAKEN",
                            "MATCH_LOCKED",
                            "ALREADY_CLAIMED",
                            "ALREADY_ANSWERED",
                            "INVALID_STORAGE_TYPE",
                            "QR_EXPIRED",
                            "IMAGE_TOO_LARGE",
