          "인증"
        ],
        "summary": "가입 인증 코드 메일 발송 (F-04)",
        "description": "학교 이메일만. 같은 이메일은 1분에 한 번. 코드는 10분 유효.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "발송함"
