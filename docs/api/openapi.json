    "/auth/email/verify": {
      "post": {
        "tags": [
          "인증"
        ],
        "summary": "인증 코드 확인 (F-04)",
        "description": "가장 최근에 받은 코드만 유효. 5번 틀리면 다시 받아야 한다. 성공하면 10분짜리 가입용 토큰.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "email",
                  "code"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "확인됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verificationToken": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "verificationToken",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "INVALID_CODE",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "VALIDATION_ERROR",
                            "INVALID_EMAIL_DOMAIN",
                            "INVALID_CODE",
                            "UNAUTHORIZED",
                            "FORBIDDEN",
                            "NOT_FOUND",
                            "EMAIL_TAKEN",
                            "MATCH_LOCKED",
                            "ALREADY_CLAIMED",
                            "ALREADY_ANSWERED",
                            "INVALID_STORAGE_TYPE",
                            "QR_EXPIRED",
                            "IMAGE_TOO_LARGE",
                            "NO_OBJECT_DETECTED",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR",
                            "AI_UNAVAILABLE"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "message": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "message"
                            ]
                          }
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
