# 공공데이터포털 (LOST112)
DATA_GO_KR_SERVICE_KEY=

# Gemini. AI_MODE=mock이면 키 없이 가짜 응답으로 동작한다.
GEMINI_API_KEY=
AI_MODE=mock

# 로컬 DB: npm run db:up 후 아래 값 그대로 사용
DATABASE_URL=postgresql://chajeumpyo:chajeumpyo@localhost:5432/chajeumpyo

# 서버
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# 회원가입
ALLOWED_EMAIL_DOMAINS=skuniv.ac.kr
ACCESS_TOKEN_TTL_HOURS=168
DEMO_TTL_HOURS=24

# 인증 메일. console이면 메일 대신 서버 로그에 코드가 찍힌다.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS는 구글 계정의 앱 비밀번호
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=찾음표 <no-reply@chajeumpyo.local>
