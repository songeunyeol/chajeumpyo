# 공공데이터포털 (LOST112)
DATA_GO_KR_SERVICE_KEY=

# Gemini. AI_MODE=mock
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001이면 키 없이 가짜 응답으로 동작한다.
GEMINI_API_KEY=
AI_MODE=mock

# 로컬 DB: 비밀번호를 정한 뒤 npm run db:up. DATABASE_URL의 비밀번호도 같은 값으로 맞춘다.
# 이미 만든 DB 볼륨은 처음 정한 비밀번호를 유지한다. 바꾸려면 docker compose down -v 후 다시 띄운다(데이터 삭제).
POSTGRES_PASSWORD=change-me-local-db-password
DATABASE_URL=postgresql://chajeumpyo:change-me-local-db-password@localhost:5432/chajeumpyo

# 서버
PORT=4000
CORS_ORIGIN=http://localhost:5173
# 32자 이상. 예: openssl rand -hex 32
JWT_SECRET=

# 회원가입. 필수(기본값 없음). 쉼표로 여러 개, @ 뒤 도메인 전체가 정확히 같아야 한다
ALLOWED_EMAIL_DOMAINS=skuniv.ac.kr
ACCESS_TOKEN_TTL_HOURS=168
DEMO_TTL_HOURS=24

# 인증 메일. console이면 메일 대신 서버 로그에 코드가 찍힌다.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS는 구글 계정의 앱 비밀번호
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=찾음표 <no-reply@chajeumpyo.local>
# 하루 인증 메일 전체 상한
MAIL_DAILY_LIMIT=300

# 캡차 (Cloudflare Turnstile). 개발은 off, production은 turnstile + 비밀 키 필수
CAPTCHA_MODE=off
TURNSTILE_SECRET_KEY=

# production에서 /api/docs를 열려면 true
API_DOCS_ENABLED=false

# 사진 저장소 (local: backend/uploads에 저장, 서명 URL로만 접근)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000
FOUND_ITEM_RETENTION_DAYS=30
AI_TIMEOUT_MS=8000
