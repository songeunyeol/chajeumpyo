// 기준: docs/spec/02_ERD.md. 테이블·컬럼 이름은 DB에서 snake_case로 쓴다(raw SQL 작성 편의).
// 바뀐 점과 미결 사항은 docs/open-issues.md 참고.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
  DEMO
}

enum StorageOrg {
  CENTER
  GUARD
}

enum Category {
  WALLET
  ID_CARD
  DRIVER_LICENSE
  PAYMENT_CARD
  TRANSIT_CARD
  OTHER_CARD
  PHONE
  EARPHONE
  SMARTWATCH
  TABLET
  LAPTOP
  CHARGER
  BAG
  CLOTHING
  HAT
  BOOK
  GLASSES
  ACCESSORY
  CASH
  UMBRELLA
  TUMBLER
  KEY
  STATIONERY
  ETC
}

enum StorageType {
  IN_PLACE
  HANDED_OVER
}

enum FoundStatus {
  ANALYZING
  REVIEW
  REGISTERED
  REVEALED
  CLAIMED
  EXPIRED
}

enum ReportStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum MatchResult {
  PASS
  BORDERLINE
  FAIL
}

enum PickupMethod {
  CENTER_QR
  SELF_REPORT
  /// 온라인 확인이 막힌 물건(#29)을 관리자가 신분을 직접 확인하고 내준 경우. 계정 없이 관리자 기록만 남는다
  IN_PERSON
  DEMO
}

enum PickupStatus {
  ISSUED
  COMPLETED
  EXPIRED
}

enum NotificationType {
  NEW_CANDIDATE
  MULTI_REVEAL
  CLAIM_LOCKED
  SYSTEM
  /// 관리자: 습득자가 보관처에 맡긴다고 등록한 물건. 실물이 오기를 기다린다 (QA 10/30 3차)
  ITEM_INCOMING
  /// 관리자: 확인을 통과한 사람이 수령 QR을 받았다. 24시간 안에 찾으러 온다
  PICKUP_SCHEDULED
  /// 관리자: 귀중품이 그 자리에 등록됐다. 필요하면 교무처로 옮긴다 (10/30 귀중품 보관처 추천으로 변경)
  VALUABLE_IN_PLACE
}

/// 관리자가 보관을 끝낸 이유 (QA 10/30 3차: 관리자 화면에 지우는 기능이 없음)
enum ClosedReason {
  /// 보관 기간 전에 폐기·이관 (예: 학과로 돌려보냄, 상한 음식)
  DISPOSED
  /// 잘못 등록함 (물건 없음, 같은 물건 중복 등록, 시험 등록)
  MISREGISTERED
}

model User {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String         @unique
  passwordHash    String         @map("password_hash")
  role            Role           @default(USER)
  /// 관리자만. 자기 보관처의 물건만 수령 처리한다.
  storagePlace    StoragePlace?  @relation(fields: [storagePlaceId], references: [id])
  storagePlaceId  Int?           @map("storage_place_id")
  /// 동의 화면 버전과 시각 (QA B15). 관리자 계정은 null
  consentVersion  String?        @map("consent_version")
  consentedAt     DateTime?      @map("consented_at")
  locationConsent Boolean        @default(false) @map("location_consent")
  createdAt       DateTime       @default(now()) @map("created_at")
  lostReports     LostReport[]
  attempts        MatchAttempt[]
  reveals         RevealLog[]
  pickups         Pickup[]       @relation("PickupUser")
  processed       Pickup[]       @relation("PickupAdmin")
  closedItems     FoundItem[]    @relation("ClosedFoundItems")
  notifications   Notification[]

  @@map("user")
}

model EmailVerification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  failCount  Int       @default(0) @map("fail_count")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  /// 가입에 쓰면 채운다. 같은 가입용 토큰 재사용 방지.
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verification")
}

model Building {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  lat           Float
  lng           Float
  sortOrder     Int            @default(0) @map("sort_order")
  foundItems    FoundItem[]
  lostReports   LostReport[]
  storagePlaces StoragePlace[]

  @@map("building")
}

/// 보관처: 종합서비스센터, 건물별 경비실 등
model StoragePlace {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  building   Building    @relation(fields: [buildingId], references: [id])
  buildingId Int         @map("building_id")
  guideText  String      @map("guide_text")
  org        StorageOrg
  isActive   Boolean     @default(true) @map("is_active")
  foundItems FoundItem[]
  admins     User[]

  @@map("storage_place")
}

/// 습득물의 공개 정보만 둔다. 후보 목록·알림은 이 테이블만 읽는다.
model FoundItem {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 주운 건물. 보관처에 맡겼고 주운 곳을 모르면 null (매칭에서 위치 점수를 "모름"으로 본다). 그 자리에 두면 필수 (CHECK 제약)
  building            Building?        @relation(fields: [buildingId], references: [id])
  buildingId          Int?             @map("building_id")
  category            Category?
  /// 2순위 종류. 후보 검색에만 쓰고 응답에 넣지 않는다.
  categoryAlt         Category?        @map("category_alt")
  /// 세부 종류 (packages/shared SUB_CATEGORIES). category에 속한 값만, 값 검증은 zod에서. 공개 정보
  subCategory         String?          @map("sub_category")
  /// 두 단계 등록에서 확정 전(ANALYZING)이면 null
  storageType         StorageType?     @map("storage_type")
  /// storage_type = HANDED_OVER면 필수 (마이그레이션 SQL의 CHECK 제약)
  storagePlace        StoragePlace?    @relation(fields: [storagePlaceId], references: [id])
  storagePlaceId      Int?             @map("storage_place_id")
  /// 습득 층. 지하는 음수, 모르면 null (공개 정보)
  floor               Int?
  status              FoundStatus      @default(ANALYZING)
  isSeed              Boolean          @default(false) @map("is_seed")
  uploaderFingerprint String?          @map("uploader_fingerprint")
  foundAt             DateTime         @default(now()) @map("found_at")
  expiresAt           DateTime?        @map("expires_at")
  /// 습득자가 등록할 때 동의한 동의 화면 버전과 위치 동의 여부 (QA B15)
  consentVersion      String?          @map("consent_version")
  locationConsent     Boolean          @default(false) @map("location_consent")
  /// 수령·기한 만료로 사진과 비공개 정보를 지운 시각 (open-issues #33)
  dataPurgedAt        DateTime?        @map("data_purged_at")
  /// 모든 계정의 확인 실패 합계가 한도(10회)에 닿아 온라인 확인을 막은 시각. 이후엔 대면 확인만 (#29)
  claimLockedAt       DateTime?        @map("claim_locked_at")
  /// 두 단계 등록(analyze → confirm)에서 확정 권한 토큰의 HMAC. 확정하면 지운다
  confirmTokenHash    String?          @map("confirm_token_hash")
  /// 관리자가 보관을 끝낸 기록. 행은 지우지 않고 기한 만료(EXPIRED)로 바꾼 뒤 이유·처리자·시각을 남긴다
  closedAt            DateTime?        @map("closed_at")
  closedReason        ClosedReason?    @map("closed_reason")
  closedBy            User?            @relation("ClosedFoundItems", fields: [closedById], references: [id])
  closedById          String?          @map("closed_by_id") @db.Uuid
  detail              FoundItemDetail?
  attempts            MatchAttempt[]
  reveals             RevealLog[]
  pickups             Pickup[]
  notifications       Notification[]
  exposures           CandidateExposure[]

  @@index([category, status, foundAt])
  @@index([categoryAlt])
  @@map("found_item")
}

/// 습득물의 비공개 정보. 일치 판정 통과자와 관리자만 접근한다.
model FoundItemDetail {
  foundItem        FoundItem                    @relation(fields: [foundItemId], references: [id], onDelete: Cascade)
  foundItemId      String                       @id @map("found_item_id") @db.Uuid
  /// 수령·만료로 지우면 null
  imageOriginalKey String?                      @map("image_original_key")
  /// 판정 통과 후 공개본: 개인정보 영역만 가린 선명본(1024px)
  imagePublicKey   String?                      @map("image_public_key")
  /// 후보 카드용 강한 블러본. 숨은 특징을 알아볼 수 없을 정도
  imageThumbKey    String?                      @map("image_thumb_key")
  isSensitive      Boolean                      @default(false) @map("is_sensitive")
  /// 기본 12색 키 (packages/shared Color). 값 검증은 zod에서
  color            String?
  brand            String?
  features         Json?
  description      String?
  /// 관리자 목록용 제목 (비공개 정보 포함)
  title            String?
  /// 습득자가 적은 자세한 위치 (예: 3층 엘리베이터 앞 벤치 위). 판정 통과 후에만 보인다
  locationDetail   String?                      @map("location_detail")
  /// 차원(1536)은 임베딩 모델 확정 후 맞춘다. 읽기·쓰기는 src/repositories/embedding.ts의 raw SQL로만.
  embedding        Unsupported("vector(1536)")?
  rawAiResponse    Json?                        @map("raw_ai_response")

  @@map("found_item_detail")
}

model LostReport {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user                User                         @relation(fields: [userId], references: [id])
  userId              String                       @map("user_id") @db.Uuid
  category            Category
  lostFrom            DateTime                     @map("lost_from")
  lostTo              DateTime                     @map("lost_to")
  building            Building?                    @relation(fields: [buildingId], references: [id])
  buildingId          Int?                         @map("building_id")
  description         String
  /// 설명이 바뀌었는지 판단 (같으면 재판정 때 시도 횟수를 쓰지 않는다)
  descriptionHash     String                       @map("description_hash")
  extractedAttributes Json?                        @map("extracted_attributes")
  embedding           Unsupported("vector(1536)")?
  status              ReportStatus                 @default(OPEN)
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  attempts            MatchAttempt[]
  notifications       Notification[]
  exposures           CandidateExposure[]

  @@map("lost_report")
}

/// 신고자에게 그 신고의 후보로 보여 준 적 있는 물건 (후보 목록 응답·새 후보 알림).
/// 후보는 요청마다 다시 고르므로 새 습득물이 들어오면 보던 물건이 상위 3개에서 밀려날 수 있다.
/// 한 번이라도 보여 준 물건은 지금도 후보 범위(종류·시간·상태·기한) 안이면 판정을 요청할 수 있다.
model CandidateExposure {
  lostReport   LostReport @relation(fields: [lostReportId], references: [id], onDelete: Cascade)
  lostReportId String     @map("lost_report_id") @db.Uuid
  foundItem    FoundItem  @relation(fields: [foundItemId], references: [id], onDelete: Cascade)
  foundItemId  String     @map("found_item_id") @db.Uuid
  firstShownAt DateTime   @default(now()) @map("first_shown_at")

  @@id([lostReportId, foundItemId])
  @@index([foundItemId])
  @@map("candidate_exposure")
}

model MatchAttempt {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user               User        @relation(fields: [userId], references: [id])
  userId             String      @map("user_id") @db.Uuid
  lostReport         LostReport  @relation(fields: [lostReportId], references: [id])
  lostReportId       String      @map("lost_report_id") @db.Uuid
  foundItem          FoundItem   @relation(fields: [foundItemId], references: [id])
  foundItemId        String      @map("found_item_id") @db.Uuid
  /// 시도 당시 신고 설명의 해시
  descriptionHash    String      @map("description_hash")
  score              Float
  scoreBreakdown     Json        @map("score_breakdown")
  matchedFields      Json        @map("matched_fields")
  result             MatchResult
  question           String?
  questionFeatureKey String?     @map("question_feature_key")
  answerCorrect      Boolean?    @map("answer_correct")
  answeredAt         DateTime?   @map("answered_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  reveals            RevealLog[]

  @@index([userId, foundItemId])
  @@map("match_attempt")
}

model RevealLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  userId         String        @map("user_id") @db.Uuid
  foundItem      FoundItem     @relation(fields: [foundItemId], references: [id])
  foundItemId    String        @map("found_item_id") @db.Uuid
  matchAttempt   MatchAttempt? @relation(fields: [matchAttemptId], references: [id])
  /// 열람할 때마다 한 줄씩 남기므로 같은 시도로 여러 줄이 생길 수 있다
  matchAttemptId String?       @map("match_attempt_id") @db.Uuid
  revealedAt     DateTime      @default(now()) @map("revealed_at")

  @@index([foundItemId])
  @@index([userId, foundItemId])
  @@map("reveal_log")
}

/// 물건당 여러 건 가능(QR 재발급). 완료는 물건당 1건 (체험 수령 DEMO 제외).
model Pickup {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  foundItem          FoundItem    @relation(fields: [foundItemId], references: [id])
  foundItemId        String       @map("found_item_id") @db.Uuid
  /// IN_PERSON이면 null (찾으러 온 사람의 계정을 모를 수 있음). 마이그레이션 SQL의 CHECK 제약
  user               User?        @relation("PickupUser", fields: [userId], references: [id], onDelete: Restrict)
  userId             String?      @map("user_id") @db.Uuid
  method             PickupMethod
  status             PickupStatus @default(ISSUED)
  qrTokenHash        String?      @map("qr_token_hash")
  qrExpiresAt        DateTime?    @map("qr_expires_at")
  processedBy        User?        @relation("PickupAdmin", fields: [processedByAdminId], references: [id])
  processedByAdminId String?      @map("processed_by_admin_id") @db.Uuid
  /// IN_PERSON일 때 관리자가 남긴 신분 확인 메모 (개인정보). 수령 기록과 함께 30일 뒤 지운다 (F-12)
  verificationNote   String?      @map("verification_note")
  createdAt          DateTime     @default(now()) @map("created_at")
  completedAt        DateTime?    @map("completed_at")
  purgeAfter         DateTime?    @map("purge_after")

  @@unique([foundItemId], map: "pickup_one_completed_per_item", where: raw("status = 'COMPLETED' AND method <> 'DEMO'"))
  @@index([foundItemId])
  @@index([userId, status])
  @@map("pickup")
}

model Notification {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user         User             @relation(fields: [userId], references: [id])
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  foundItem    FoundItem?       @relation(fields: [foundItemId], references: [id])
  foundItemId  String?          @map("found_item_id") @db.Uuid
  lostReport   LostReport?      @relation(fields: [lostReportId], references: [id])
  lostReportId String?          @map("lost_report_id") @db.Uuid
  message      String
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notification")
}
